{
  "cli": {
    "version": ">= 12.0.0",
    "appVersionSource": "remote"
  },
  "app": {
    "name": "Nexa",
    "android": {
      "package": "com.nexa.mobile",
      "versionCode": 1,
      "versionName": "0.1.0"
    }
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      }
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      }
    },
    "production": {
      "android": {
        "buildType": "apk"
      }
    }
  },
  "submit": {
    "production": {
      "android": {
        "serviceAccountKeyPath": "google-service-account.json",
        "track": "internal"
      }
    }
  }
}
